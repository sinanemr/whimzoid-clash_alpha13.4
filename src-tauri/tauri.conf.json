{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "What Just Hit Me",
  "version": "1.0.0",
  "identifier": "com.whatjusthitme.game",
  "build": {
    "beforeDevCommand": "npm run build:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "What Just Hit Me?",
        "url": "RUN_GAME.html",
        "width": 1024,
        "height": 660,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
